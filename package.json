{
  "name": "@dsh-external/dsh-onebot",
  "version": "0.1.0",
  "description": "QQ bot channel for dsh via the OneBot 11 protocol (NapCat / Lagrange / LLOneBot / go-cqhttp): reverse- or forward-WebSocket, DM + group chats with mention gating and allowlists, inbound image/voice handling (whisper STT), sentence-boundary splitting for long replies, [[qq_forward]] merged forwards, and a whitelisted NapCat API proxy tool",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "BSD-3-Clause",
  "engines": {
    "dsh": ">=0.0.1",
    "node": ">=22"
  },
  "dshx": {
    "contributes": {
      "tools": [
        "qq_send_image",
        "qq_send_voice",
        "qq_send_video",
        "qq_send_file",
        "qq_send_forward",
        "qq_napcat_api",
        "qq_group_history"
      ],
      "skills": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "schemastery": "^3.18.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.6",
    "fontkit": "^2.0.4",
    "schemastery": "^3.18.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "build": "./scripts/build.sh",
    "test": "vitest run"
  }
}
